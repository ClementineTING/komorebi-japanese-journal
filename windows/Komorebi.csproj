<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net48</TargetFramework><UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Komorebi</AssemblyName><RootNamespace>Komorebi</RootNamespace><PlatformTarget>x64</PlatformTarget>
    <Version>1.1.0</Version><LangVersion>latest</LangVersion><AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" /></ItemGroup>
  <ItemGroup><Reference Include="System.Web.Extensions" /></ItemGroup>
  <ItemGroup><Content Include="..\web\index.html" Link="web\index.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\licenses\**\*" Link="licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
